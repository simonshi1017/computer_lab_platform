# 部署环境变量。复制成 deploy/.env 后按需修改（.env 已被 gitignore）。
#
# 原则：**全部有默认值，不填也能起来**。但标了 ⚠️ 的几项在生产必须改。

# ---- 站点 ----
# 对外访问端口；前面还有一层网关时随便填，网关转发到这个端口即可
CLAB_PORT=8080
# 生成分享链接用的对外地址，必须是用户浏览器里能打开的地址
FRONTEND_URL=http://localhost:8080

# ---- 数据库 ----
POSTGRES_USER=clab
POSTGRES_PASSWORD=clab
POSTGRES_DB=clab

# ---- 鉴权 ----
# ⚠️ 必改：换掉它等于让所有已签发的 token 立即失效
JWT_SECRET=please-change-this-to-a-long-random-string
# 内网试用期保持 dev：未配 SMTP/企微时验证码会直接回传前端，dev 一键登录可用。
# 配好 SMTP 或企业微信后改 prod —— 那会关掉 dev 登录，验证码改走真实邮件。
APP_ENV=dev

# ---- 管理后台 /admin ----
# ⚠️ 必改：默认口令只为内网首次部署留一个入口
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_IN_DEPLOY_ENV
ADMIN_SESSION_SECRET=please-change-this-too

# ---- 企业微信扫码登录 ----
# 四项全部填写后才会启用；缺任意一项接口返回 501，前端隐藏扫码按钮
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 企业微信后台配置的可信回调域名 + 本服务路径
WECOM_REDIRECT_URI=https://your-domain.example.com/api/v1/auth/wecom/callback

# ---- 邮箱验证码 ----
# 不填则：APP_ENV=dev 时验证码直接回给前端；APP_ENV=prod 时接口返回 501
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- 构建 ----
# 内网构建时换成公司镜像，例如 https://mirrors.aliyun.com/pypi/simple/
PIP_INDEX_URL=https://pypi.org/simple

# ---- M7 数据自动化 ----
# 价格超过多少天没更新就标黄 + 每日告警
PRICE_STALE_DAYS=45
SCHEDULER_ENABLED=true
PRICE_CHECK_CRON=0 9 * * *
# 企业微信群机器人 webhook（可选）：不填只写日志，不填也能跑
ALERT_WEBHOOK=

LOG_LEVEL=INFO
