  "glossary": [
    {
      "id": "params",
      "term": "参数量",
      "en": "Parameters",
      "alias": [
        "参数",
        "B",
        "参数量 B"
      ],
      "category": "模型",
      "plain": "模型脑子里有多少个「可调的旋钮」。7B 就是 70 亿个旋钮，70B 就是 700 亿个。",
      "pro": "神经网络中可训练权重的总数，单位通常为 B（billion，十亿）。直接决定权重显存：FP16 每参数 2 字节，INT4 每参数 0.5 字节。",
      "mistake": "「参数越大越聪明」不完全成立。数据质量和训练方法影响更大，7B 的 Qwen 在中文任务上常胜过某些更大的旧模型。",
      "related": [
        "quant",
        "vram",
        "dense-moe"
      ]
    },
    {
      "id": "ctx",
      "term": "上下文窗口",
      "en": "Context Window",
      "alias": [
        "上下文",
        "context",
        "ctx"
      ],
      "category": "模型",
      "plain": "模型一次能记住多少内容。32K 大约等于一次读进五万字，128K 差不多是一本小说。",
