  "glossary": [
    {
      "id": "params",
      "term": "参数量",
      "en": "Parameters",
      "alias": [
        "参数",
        "B",
        "参数量 B"
      ],
      "category": "模型",
      "plain": "模型脑子里有多少个「可调的旋钮」。7B 就是 70 亿个旋钮，70B 就是 700 亿个。",
      "pro": "神经网络中可训练权重的总数，单位通常为 B（billion，十亿）。直接决定权重显存：FP16 每参数 2 字节，INT4 每参数 0.5 字节。",
      "mistake": "「参数越大越聪明」不完全成立。数据质量和训练方法影响更大，7B 的 Qwen 在中文任务上常胜过某些更大的旧模型。",
      "related": [
        "quant",
        "vram",
        "dense-moe"
      ]
    },
    {
      "id": "ctx",
      "term": "上下文窗口",
      "en": "Context Window",
      "alias": [
        "上下文",
        "context",
        "ctx"
      ],
      "category": "模型",
      "plain": "模型一次能记住多少内容。32K 大约等于一次读进五万字，128K 差不多是一本小说。",
      "pro": "单次推理可处理的最大 token 数，含输入与输出。超出会被截断。KV Cache 显存随上下文长度线性增长，是长上下文的主要成本。",
      "mistake": "「标称 32K 就能稳定用 32K」——多数模型在中段信息的检索上会衰减，且上下文越长生成越慢、显存越吃紧。",
      "related": [
        "kv-cache",
        "token",
        "vram"
      ]
    },
    {
      "id": "quant",
      "term": "量化",
      "en": "Quantization",
      "alias": [
        "INT4",
        "INT8",
        "FP16",
        "量化方式"
      ],
      "category": "显存",
      "plain": "把厚书压缩成口袋书。字还是那些字，但纸变薄了，能塞进更小的包。",
      "pro": "降低权重数值精度以减少显存占用与带宽压力。FP16 每参数 2 字节、INT8 为 1 字节、INT4 为 0.5 字节。INT4 通常带来 3–4 倍显存下降，质量损失在多数对话任务中不明显。",
      "mistake": "「量化一定掉智商」——INT8 几乎无损，INT4 在通用对话里损失很小，真正掉得多的是数学和长链推理。另外量化省显存但不一定提速，瓶颈在带宽时才有收益。",
      "related": [
        "params",
        "vram",
        "gguf"
      ]
    },
    {
      "id": "vram",
      "term": "显存",
      "en": "VRAM",
      "alias": [
        "显存容量",
        "显卡内存"
      ],
      "category": "显存",
      "plain": "显卡自己的工作台。模型必须整个摊在台面上才能干活，台面不够就放不下。",
      "pro": "GPU 板载内存，用于存放模型权重、KV Cache 与中间激活值。容量决定「能不能装下」，带宽决定「算得快不快」，两者不可互相替代。",
      "mistake": "「显存越大越快」——容量只决定装不装得下。速度取决于带宽；一张 48G 的 A6000（768GB/s）跑 7B 明显慢于 24G 的 4090（1008GB/s）。",
      "related": [
        "bandwidth",
        "kv-cache",
        "quant"
      ]
    },
    {
      "id": "kv-cache",
      "term": "KV Cache",
      "en": "Key-Value Cache",
      "alias": [
        "KV",
        "缓存"
      ],
      "category": "显存",
      "plain": "模型边聊边记的小抄。聊得越久、记得越多，小抄就越厚，占的地方也越大。",
      "pro": "自回归生成时缓存历史 token 的 Key/Value 张量，避免重复计算。大小 ≈ 2 × 层数 × KV 维度 × 上下文长度 × batch × 字节数；GQA 架构下 KV 维度约为隐藏维度的 1/4 到 1/8。",
      "mistake": "估显存只算权重。27B 模型 INT4 权重只有 12.6GB，但 32K 上下文的 KV Cache 要 10.7GB——这部分不算，就会买到「能加载、一对话就崩」的卡。",
      "related": [
        "ctx",
        "gqa",
        "vram"
      ]
    },
    {
      "id": "token",
      "term": "Token",
      "en": "Token",
      "alias": [
        "词元",
        "tokens"
      ],
      "category": "模型",
      "plain": "模型眼里的「字」。一个汉字大约 1 个 token，一个英文单词大约 1.3 个 token。",
      "pro": "分词器输出的最小单位。计费、上下文长度、生成速度都以 token 计。中文常见为 1 字 ≈ 1 token（视词表而定）。",
      "mistake": "把 tokens/s 直接当字/秒。中文场景下大约要乘 0.9，而英文场景差别更大。",
      "related": [
        "ctx",
        "tps"
      ]
    },
    {
      "id": "tps",
      "term": "生成速度",
      "en": "Tokens per Second",
      "alias": [
        "tps",
        "tokens/s",
        "吞吐"
      ],
      "category": "模型",
      "plain": "模型每秒能蹦几个字。低于 8 个就开始一顿一顿，20 以上读起来才顺。",
      "pro": "解码阶段的输出速率。单请求场景受显存带宽限制，近似为 带宽 ÷ 权重体积 × 效率系数；并发场景还受算力与批处理策略影响。",
      "mistake": "「买更贵的卡就一定更快」——跑小模型时瓶颈在带宽，跑大模型时可能在算力，跑并发时又在显存容量。要看具体场景。",
      "related": [
        "bandwidth",
        "token"
      ]
    },
    {
      "id": "bandwidth",
      "term": "显存带宽",
      "en": "Memory Bandwidth",
      "alias": [
        "带宽",
        "GB/s"
      ],
      "category": "硬件",
      "plain": "工作台旁边的传送带有多快。台面再大，传送带慢，搬东西还是慢。",
      "pro": "单位时间内 GPU 能读写显存的字节数，单位 GB/s，等于等效频率 × 位宽 ÷ 8。自回归解码是典型的访存瓶颈，带宽几乎线性决定单请求速度。",
      "mistake": "只看显存容量不看带宽。RTX 4060 Ti 16G 显存比 3060 12G 大，但带宽只有 288GB/s，跑同一模型反而更慢。",
      "related": [
        "vram",
        "tps"
      ]
    },
    {
      "id": "gqa",
      "term": "GQA",
      "en": "Grouped-Query Attention",
      "alias": [
        "分组查询注意力",
        "MHA",
        "MQA"
      ],
      "category": "模型",
      "plain": "多个注意力头共用一份小抄，省纸但记得住重点。",
      "pro": "Grouped-Query Attention：将 Query 头分组共享同一组 Key/Value 头。相比 MHA 大幅压缩 KV Cache（常见 4–8 倍），是现代大模型长上下文的标配。",
      "mistake": "用隐藏维度直接算 KV Cache 而不考虑 GQA，会把需求高估 3–4 倍。估算时要看模型卡里写的 num_key_value_heads。",
      "related": [
        "kv-cache",
        "ctx"
      ]
    },
    {
      "id": "dense-moe",
      "term": "Dense 与 MoE",
      "en": "Dense / Mixture of Experts",
      "category": "模型",
      "plain": "Dense 是全员上班；MoE 是分科室，每次只叫相关的几个科室来干活。",
      "pro": "Dense 模型每个 token 都经过全部参数；MoE 通过路由只激活部分专家。MoE 总参数量大但激活参数少，因此显存占用看总参数、计算量看激活参数。",
      "mistake": "把 MoE 的总参数量当成计算量。一个 236B 的 MoE 可能只激活 21B，但显存仍要按 236B 准备——省算力不省显存。",
      "related": [
        "params",
        "vram"
      ]
    },
    {
      "id": "tdp",
      "term": "TDP",
      "en": "Thermal Design Power",
      "alias": [
        "功耗",
        "热设计功耗"
      ],
      "category": "硬件",
      "plain": "这个部件满负荷干活时会发多少热。发热越大，电源和散热就越要跟上。",
      "pro": "热设计功耗，单位 W。整机功耗通常按 ΣTDP × 1.2 估算，电源建议 ≥ 整机功耗 × 1.3，以覆盖瞬时峰值与转换损耗。",
      "mistake": "「电源功率越大越费电」——电源只是上限，实际耗电取决于负载。选小了才会跳闸，选大了不会更费电（但低负载效率略降）。",
      "related": [
        "psu",
        "vram"
      ]
    },
    {
      "id": "psu",
      "term": "电源冗余",
      "en": "PSU Headroom",
      "category": "硬件",
      "plain": "电源要留点余量，别让它在满负荷边上喘气。",
      "pro": "推荐电源额定功率 ≥ 整机峰值功耗 × 1.3。多卡配置还要看 12V 联合输出与 PCIe 供电接口数量，而非只看总瓦数。",
      "mistake": "只看总瓦数不看接口。四张卡要 8 个 8pin，很多 1600W 电源给不了这么多路。",
      "related": [
        "tdp"
      ]
    },
    {
      "id": "pcie",
      "term": "PCIe 通道",
      "en": "PCIe Lanes",
      "category": "硬件",
      "plain": "显卡插在主板上的「插座」，插座越多能插的卡越多。",
      "pro": "主板提供的 PCIe 通道数决定可同时安装的显卡数量与带宽分配。消费级平台通常只能拆分为 x8/x8，多卡推理的卡间通信会受限。",
      "mistake": "以为能插就能跑。四卡需要 4 条物理 x16 插槽 + 足够通道，消费级主板通常做不到，得用工作站或服务器平台。",
      "related": [
        "tdp"
      ]
    },
    {
      "id": "gguf",
      "term": "GGUF",
      "en": "GGUF / GGML",
      "category": "部署",
      "plain": "一种把模型打包成「单文件」的格式，下载下来就能跑，像绿色免安装软件。",
      "pro": "llama.cpp 使用的模型文件格式，支持多种量化等级（Q4_K_M、Q5_K_M、Q8_0 等）与 CPU/GPU 混合推理，是 Ollama、LM Studio 的底层格式。",
      "mistake": "Q4_K_M 不等于纯 INT4。它是混合精度量化，平均位宽略高于 4bit，显存占用比理论值稍大，但质量更稳。",
      "related": [
        "quant",
        "ollama"
      ]
    },
    {
      "id": "ollama",
      "term": "Ollama",
      "en": "Ollama",
      "category": "部署",
      "plain": "一条命令就能把模型跑起来的工具，省掉装驱动、配环境的麻烦。",
      "pro": "基于 llama.cpp 的本地推理运行时，提供模型拉取、量化版本管理、OpenAI 兼容 API。适合单机验证与轻量服务，不适合高并发生产。",
      "mistake": "用 Ollama 做生产服务。它默认单请求串行、缺少批处理与多卡调度，并发上来会排队；生产环境应换 vLLM 或 SGLang。",
      "related": [
        "gguf",
        "vllm"
      ]
    },
    {
      "id": "vllm",
      "term": "vLLM",
      "en": "vLLM",
      "category": "部署",
      "plain": "给多人同时用准备的加速引擎，能把显卡利用率榨得更干。",
      "pro": "基于 PagedAttention 的高吞吐推理引擎，支持连续批处理、前缀缓存、张量并行。相同硬件下并发吞吐常为朴素实现的数倍。",
      "mistake": "单机自用也上 vLLM。它会预占大部分显存做 KV Cache 池，单人场景反而更吃显存、启动更慢。",
      "related": [
        "ollama",
        "kv-cache"
      ]
    }
  ],
  "lessons": [
    {
      "id": "l1",
      "level": 1,
      "title": "模型入门",
      "question": "模型是什么？参数、上下文、能力分别代表什么？",
      "output": "选一个「我的第一个模型」，并说清为什么选它",
      "points": [
        "参数量 = 有多少个可调旋钮，决定「要多大显存」",
        "上下文 = 一次能记住多少，决定「能读多长的文档」",
        "参数量不等于能力，语种与训练数据同样关键",
        "Dense 与 MoE：一个全员上班，一个分科室干活"
